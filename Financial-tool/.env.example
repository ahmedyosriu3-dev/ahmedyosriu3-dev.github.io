# Alpaca PAPER keys: https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Live-trading lock #1. Leave false. Flipping this alone is not enough to trade
# live -- the dashboard flag and a typed confirmation are also required.
ALPACA_LIVE=false

# ---------------------------------------------------------------------------
# Telegram. Alerts on your phone, and optionally buttons that act.
#
# Setup: message @BotFather -> /newbot -> copy the token here -> restart ->
# message your new bot anything -> Settings -> "Find my chat id".
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Let the Approve button in Telegram actually submit the order, instead of
# only telling you about it. This puts a spend-money button on your phone:
# anyone holding the unlocked phone, or the bot token, can press it. The risk
# gate still applies to every tap.
TELEGRAM_ALLOW_APPROVALS=false

# ...and allow that even when live trading is armed, i.e. with real money.
# Live approvals always require a second confirming tap. Leave this false
# unless you have thought about losing the phone.
TELEGRAM_ALLOW_LIVE_APPROVALS=false

# Seconds per long-poll. A ceiling on how long a tap waits, not a busy loop.
TELEGRAM_POLL_TIMEOUT=25

# ---------------------------------------------------------------------------
# Idea scout. Screens a curated universe weekly and suggests things to look
# at. Suggestions only -- it never sizes or places anything.
# ---------------------------------------------------------------------------
# Any of: stocks, sector_etf, bonds, commodities
SCOUT_UNIVERSES=stocks,sector_etf,bonds,commodities
SCOUT_MAX_IDEAS=12
SCOUT_MIN_DOLLAR_VOLUME=5000000

# ---------------------------------------------------------------------------
# Optional AI analyst. Commentary only -- it never places or approves orders.
# ---------------------------------------------------------------------------
# none | ollama | gemini
AI_PROVIDER=none

# Local model via Ollama (https://ollama.com). Nothing leaves your machine.
# Pull one first:  ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Google Gemini. NOTE: this sends the market-data briefing to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Symbol logos. The server fetches each one once and caches it in data/logos/;
# your browser never contacts the provider. Symbols with no artwork fall back
# to a monogram tile drawn locally. Set to false for no outbound requests.
# ---------------------------------------------------------------------------
LOGOS_ENABLED=true
# {symbol} = upper-case ticker, {symbol_lower} = lower-case.
# Alternative that covers some ETFs differently:
#   https://assets.parqet.com/logos/symbol/{symbol}?format=png&size=128
LOGO_URL_TEMPLATE=https://financialmodelingprep.com/image-stock/{symbol}.png
